# ==========================================
# Developer Growth Log - Git Ignore Policy
# ==========================================

# ------------------------------------------
# .NET / C# (Backend)
# ------------------------------------------
**/bin/
**/obj/
*.user
*.userosscache
*.sln.docstates
*.suo
.vs/
.idea/
*.user
*.VisualState.xml
TestResults/
*.DotSettings.user

# Local appsettings overrides
**/appsettings.Development.json.local
**/appsettings.Production.json
**/appsettings.Local.json

# ------------------------------------------
# Node.js / React / Vite (Frontend)
# ------------------------------------------
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
**/.tmp/
**/.oxc/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Local Secrets
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
