# ==========================================
# Developer Growth Log - Backend Configuration
# ==========================================

# SQL Server Veritabanı Bağlantı Cümlesi
ConnectionStrings__DefaultConnection="Server=(localdb)\\mssqllocaldb;Database=GrowthLogDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

# JWT Kimlik Doğrulama Yapılandırması
Jwt__Secret="super-secret-key-that-is-at-least-32-characters-long-growth-log-2026"
Jwt__Issuer="GrowthLog.Api"
Jwt__Audience="GrowthLog.Client"
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7

# CORS İzin Verilen Frontend Kökenleri
Cors__AllowedOrigins__0="http://localhost:5173"
Cors__AllowedOrigins__1="http://localhost:3000"
Cors__AllowedOrigins__2="http://127.0.0.1:5173"

# Çalışma Ortamı (Development / Production)
ASPNETCORE_ENVIRONMENT="Development"
